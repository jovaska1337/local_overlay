+Preferences.addSetting({
+  id: "enableJavaScript",
+  pref: "javascript.enabled",
+});
+
+Preferences.addSetting({
+  id: "disableJavaScript",
+  deps: ["enableJavaScript"],
+  get: (_value, deps) => {
+    return !deps.enableJavaScript.value;
+  },
+  set: (checked, deps) => {
+    deps.enableJavaScript.value = !checked;
+  },
+});
+
+Preferences.addSetting({
+  id: "useDocumentFonts",
+  pref: "browser.display.use_document_fonts",
+});
+
+Preferences.addSetting({
+  id: "disableCustomFonts",
+  deps: ["useDocumentFonts"],
+  get: (_value, deps) => {
+    return deps.useDocumentFonts.value == 0;
+  },
+  set: (checked, deps) => {
+    deps.useDocumentFonts.value = checked ? 0 : 1;
+  },
+});
+
+Preferences.addSetting({
+  id: "isolateRequestFirstParty",
+  pref: "privacy.firstparty.isolate",
+});
+
+Preferences.addSetting({
+  id: "autoUpdateExtensions",
+  pref: "extensions.update.enabled",
+});
+
+Preferences.addSetting({
+  id: "spoofReferrers",
+  pref: "network.http.referer.spoofSource",
+});
+
+Preferences.addSetting({
+  id: "detectCaptivePortal",
+  pref: "network.captive-portal-service.enabled",
+});
+
+Preferences.addSetting({
+  id: "detectNetworkConnectivity",
+  pref: "network.connectivity-service.enabled",
+});
+
+Preferences.addSetting({
+  id: "geoIPURL",
+  pref: "browser.search.geoip.url",
+});
+
+Preferences.addSetting({
+  id: "geolocation",
+  deps: ["geoIPURL"],
+  get: (_value, deps) => {
+    return deps.geoIPURL.value !== "";
+  },
+  set: (checked, deps) => {
+    deps.geoIPURL.value = checked ? "https://location.services.mozilla.com/v1/country?key=%MOZILLA_API_KEY%" : "";
+  },
+});
+
+Preferences.addSetting({
+  id: "webglDisabled",
+  pref: "webgl.disabled",
+});
+
+Preferences.addSetting({
+  id: "webgl",
+  deps: ["webglDisabled"],
+  get: (_value, deps) => {
+    return !deps.webglDisabled.value;
+  },
+  set: (checked, deps) => {
+    deps.webglDisabled.value = !checked;
+  },
+});
+
